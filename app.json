{
  "expo": {
    "name": "Scan Kit",
    "slug": "scan-kit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scankit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan Kit needs camera access to scan documents.",
        "NSMicrophoneUsageDescription": "Scan Kit doesn’t use the microphone or record audio.",
        "NSCalendarsUsageDescription": "Scan Kit adds the dates you pick in a scanned page to your calendar.",
        "NSContactsUsageDescription": "Scan Kit saves the business cards you scan as new contacts.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.jpeg",
              "public.png",
              "public.heic",
              "public.image"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false,
        "UIFileSharingEnabled": false,
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.zerohorizon.scan.scan",
            "UIApplicationShortcutItemTitle": "Scan document",
            "UIApplicationShortcutItemIconSymbolName": "camera"
          },
          {
            "UIApplicationShortcutItemType": "com.zerohorizon.scan.import-photos",
            "UIApplicationShortcutItemTitle": "Import photos",
            "UIApplicationShortcutItemIconSymbolName": "photo.on.rectangle"
          },
          {
            "UIApplicationShortcutItemType": "com.zerohorizon.scan.import-file",
            "UIApplicationShortcutItemTitle": "Import file",
            "UIApplicationShortcutItemIconSymbolName": "folder"
          },
          {
            "UIApplicationShortcutItemType": "com.zerohorizon.scan.search",
            "UIApplicationShortcutItemTitle": "Search",
            "UIApplicationShortcutItemIconSymbolName": "magnifyingglass"
          }
        ]
      },
      "bundleIdentifier": "com.zerohorizon.scan"
    },
    "android": {
      "package": "com.zerohorizon.scan",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 340,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-document-scanner-plugin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Scan Kit with Face ID."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/with-pod-deployment-target",
      [
        "expo-media-library",
        {
          "photosPermission": "Scan Kit uses your photo library to import photos of documents.",
          "savePhotosPermission": "Scan Kit saves exported pages to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/with-android-platform"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "366af2ae-96c4-48e2-9197-5b782e804cff"
      }
    }
  }
}
