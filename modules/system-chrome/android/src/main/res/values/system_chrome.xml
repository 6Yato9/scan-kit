<?xml version="1.0" encoding="utf-8"?>
<!--
  The look of React Native's Alert on Android (androidx AlertDialog), matched
  to the app (lib/theme.ts): its card colour, text colours and accent, rounded
  corners like the app's sheets, and buttons in sentence case ("Keep editing",
  "Discard") instead of the AppCompat default ALL CAPS in a stock teal.
  Night colours are in values-night/.
-->
<resources>
  <color name="system_chrome_surface">#FFFFFF</color>
  <color name="system_chrome_text">#1A1A1A</color>
  <color name="system_chrome_secondary">#555555</color>
  <color name="system_chrome_accent">#0A7EA4</color>

  <style name="SystemChromeOverlay">
    <item name="alertDialogTheme">@style/SystemChromeAlertDialog</item>
    <item name="android:alertDialogTheme">@style/SystemChromeAlertDialog</item>
  </style>

  <style name="SystemChromeAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="android:windowBackground">@drawable/system_chrome_dialog_background</item>
    <item name="colorAccent">@color/system_chrome_accent</item>
    <item name="android:colorAccent">@color/system_chrome_accent</item>
    <item name="android:textColorPrimary">@color/system_chrome_text</item>
    <item name="android:textColorSecondary">@color/system_chrome_secondary</item>
    <item name="android:textColorAlertDialogListItem">@color/system_chrome_text</item>
    <item name="buttonBarButtonStyle">@style/SystemChromeDialogButton</item>
    <item name="android:buttonBarButtonStyle">@style/SystemChromeDialogButton</item>
  </style>

  <style name="SystemChromeDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/system_chrome_accent</item>
    <item name="android:textSize">16sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
</resources>
